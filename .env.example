# Copy to .env and fill in. Never commit .env.

# Public origin Caddy serves; used for OAuth redirect and links.
PUBLIC_BASE_URL=https://urtube.observe.tw
OWNER_NAME=Sky Hong
OWNER_HANDLE=skyhong.tw

# Keep a new deployment invite-only until capacity/cost limits are chosen.
SIGNUP_ENABLED=false
SIGNUP_PER_HOUR_PER_IP=5
MAX_USERS=25
MAX_USER_DATABASE_MB=512
INGEST_REQUESTS_PER_MINUTE=300

# Admin token for Takeout upload and OAuth control (>=32 chars).
# Generate: openssl rand -base64 48 | tr -d '\n'
INGEST_TOKEN=

# Legacy owner capture token accepted by the extension endpoints (>=32 chars).
# Per-user tokens created via `npm run user:create` also work.
YOUTUBE_CAPTURE_TOKEN=

# Encrypts search queries and the OAuth refresh token (>=32 chars).
# AT CUTOVER this MUST be the same value as Infovore production, or migrated
# ciphertext cannot be decrypted. Before cutover any strong value works.
YOUTUBE_PRIVATE_DATA_KEY=

# YouTube Data API v3 key for metadata enrichment (optional).
YOUTUBE_API_KEY=
# Optional extra keys, comma separated. Used as fallbacks when the key above
# answers 403 quotaExceeded, until the next quota reset (midnight Pacific).
# Only keys from *different* Google Cloud projects add quota.
# YOUTUBE_API_KEYS=


# Google Data Portability OAuth (optional; enables daily My Activity sync).
GOOGLE_DATA_PORTABILITY_CLIENT_ID=
GOOGLE_DATA_PORTABILITY_CLIENT_SECRET=
# Defaults to $PUBLIC_BASE_URL/api/ingest/youtube/oauth/callback
# GOOGLE_DATA_PORTABILITY_REDIRECT_URI=

# Google login (openid + email only). May reuse the Data Portability client,
# but a separate OAuth client makes consent-screen and redirect changes safer.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Defaults to $PUBLIC_BASE_URL/auth/google/callback
# GOOGLE_LOGIN_REDIRECT_URI=

# Taipei hour (0-23) the daily Data Portability sync may start.
YOUTUBE_SYNC_HOUR=4

# AI topic classification (optional; OpenAI-compatible endpoint).
AI_CLASSIFICATION_ENABLED=false
# In-flight model calls across all archives (default 4); match your gateway.
AI_CONCURRENCY=4
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Per-request timeout in ms (default 60000). Raise for a queued self-hosted gateway.
AI_TIMEOUT_MS=60000

# Complete multi-user backups. Compose mounts the host directory at /backups;
# keep that host path on an off-host-synced or otherwise protected volume.
URTUBE_BACKUP_HOST_DIRECTORY=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Optional shared channel-tag source used by /<handle>/tags.
TAG_LISTS_URL=https://urtubeapi.analysis.tw/api/channels_list.php

# New tag-cluster matching is OFF by default. See docs/matching-v3.md.
# For the opt-in compose overlay, put these settings in .env.matching-v3.
MATCHING_V3_ENABLED=false
OPENAI_API_KEY=
# Classification reuses existing AI_BASE_URL / AI_API_KEY.
# MATCHING_V3_BASE_URL=https://api.openai.com/v1
# MATCHING_V3_API_KEY=
# Gemini tag embeddings always use this separate key.
GEMINI_API_KEY=
# Optional comma-separated Gemini keys; replaces the single key when nonempty.
GEMINI_API_KEYS=
MATCHING_V3_CLASSIFICATION_MODEL=gpt-5.6-luna
MATCHING_V3_EMBEDDING_MODEL=gemini-embedding-001
MATCHING_V3_DIMENSIONS=768
MATCHING_V3_EPS=0.2
MATCHING_V3_MIN_SAMPLES=5
MATCHING_V3_MIN_SHARE=0.05
MATCHING_V3_SIMILARITY_FLOOR=0.7
MATCHING_V3_CALLS_PER_CYCLE=20
# 0 disables the daily ceiling for an explicitly authorized full backfill.
MATCHING_V3_DAILY_API_CALLS=200
MATCHING_V3_CLASSIFICATION_BATCH_SIZE=5
MATCHING_V3_COMPUTE_URL=http://matching-compute:8090
# Use a random secret of at least 32 characters; shared by app/worker/compute.
MATCHING_V3_COMPUTE_TOKEN=
# Comma-separated handles allowed to view /matching-v3/admin; empty denies all.
MATCHING_V3_ADMIN_HANDLES=
MATCHING_V3_CONCURRENCY=4
# Optional stable classification cache identity when explicitly preserving
# existing results during an endpoint switch. Defaults to current base URL.
# MATCHING_V3_CLASSIFICATION_CACHE_NAMESPACE=

# Latest distinct watched videos per account for matching backfill.
MATCHING_V3_BACKFILL_VIDEO_LIMIT=2000

# Optional dedicated comparison service; leave empty to use MATCHING_V3_COMPUTE_URL.
# MATCHING_V3_COMPARE_URL=http://matching-compare:8090
