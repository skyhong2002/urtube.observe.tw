{
  "name": "urtube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "ingest": "tsx src/ingest.ts",
    "worker": "tsx src/youtube-worker.ts",
    "youtube:import": "tsx src/import-youtube.ts",
    "youtube:topics:rebuild": "tsx src/youtube-topics.ts",
    "demo:matching": "NODE_ENV=test tsx scripts/matching-demo.ts",
    "extension:release": "tsx scripts/build-extension-release.ts",
    "user:create": "tsx scripts/create-user.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore-backup.ts",
    "db:migrate-from-infovore": "tsx scripts/migrate-from-infovore.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test DATABASE_PATH=:memory: USERS_DATABASE_PATH=:memory: INGEST_TOKEN=test-token-with-at-least-32-characters YOUTUBE_PRIVATE_DATA_KEY=test-private-data-key-with-at-least-32-characters YOUTUBE_CAPTURE_TOKEN=test-youtube-capture-token-with-at-least-32-characters PUBLIC_BASE_URL=http://localhost:3000 node --import tsx --test tests/**/*.test.*",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.28",
    "tsx": "^4.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
